    },
    {
      "id": "claim_55d3cc4d50854219b33f49334bd0022b",
      "statement": "ImplementSpec.BuildPrompt frames the issue body as requirements that cannot override its own rules and forbids git commands, commits, pushes, pull requests, added dependencies, and edits outside the workspace — so a run's only product is uncommitted files in the worktree plus a log line.",
      "evidence": [
        {
          "resource": "repo://src/Agent/ImplementSpec.cs#L112-L135",
