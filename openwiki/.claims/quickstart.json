    },
    {
      "id": "claim_eb83669cc15d459ab4b6a3ab962e8283",
      "statement": "Program.cs is the entire composition root: it expands {env:NAME} placeholders in configuration before binding, binds SebastianConfig with ValidateOnStart plus a singleton ValidateSebastianConfig options validator, registers GitHubService and JobQueue as plain singletons while constructing ProviderResolver and Git through factories, exposes the same Git and JobQueue instances as hosted services, registers the internal GitHubWebhookProcessor through a factory as the WebhookEventProcessor, resolves GitHubService and ProviderResolver eagerly so missing credentials fail at startup, and maps exactly two endpoints — GET /health returning \"ok\" and MapGitHubWebhooks with the configured secret (the only inbound integration and the trust boundary).",
      "evidence": [
        {
          "resource": "repo://Program.cs#L11-L50",
          "version": "repo-lines-v1:sha256:7f16f700a2a4ecb103c34bb43bdf95ac71100bc73c264352a988643be8303275:"
        },
