    {
      "id": "claim_4b36b64088ac4b03b52350d4eaf1438c",
      "statement": "ProviderResolver resolves the model at construction: it rejects an empty provider list, rejects duplicate provider names (case-insensitive), selects the provider whose Name matches Agent.General.Provider case-insensitively, defaults a missing Endpoint to https://api.openai.com/v1, and CreateChatClient returns an IChatClient for Agent.General.Model from an OpenAIClient bound to that endpoint.",
      "evidence": [
        {
          "resource": "repo://src/Agent/ProviderResolver.cs#L15-L59",
