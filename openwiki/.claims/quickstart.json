  "claims": [
    {
      "id": "claim_d654d83e34c54288a0317bc22bad58d1",
      "statement": "AGENTS.md instructs coding agents to treat source code and tests as authoritative and the generated openwiki/ pages as optional just-in-time context, and gates wiki retrieval on user request, unfamiliar architecture, or unresolved uncertainty after source inspection.",
      "evidence": [
        {
          "resource": "repo://AGENTS.md#L5-L14",
          "version": "repo-lines-v1:sha256:965b11a851738f08a591fcd7200331a525a9902e67b614ce6d86c6a4283402a5:"
        }
      ]
    },
    {
      "id": "claim_eb83669cc15d459ab4b6a3ab962e8283",
      "statement": "Program.cs is the entire composition root: it binds and validates SebastianConfig on start, registers GitHubService, ProviderResolver, Git and JobQueue as singletons, exposes Git and JobQueue as hosted services through those same instances, registers GitHubWebhookProcessor via a factory as the WebhookEventProcessor, and maps exactly two endpoints — GET /health returning \"ok\" and MapGitHubWebhooks with the configured secret (the only inbound integration and the trust boundary).",
      "evidence": [
        {
          "resource": "repo://Program.cs#L11-L52",
          "version": "repo-lines-v1:sha256:94cf220a8fd8099f1bdd03c3d8f530f7faaf70776dfcf985b10632936d9fcfea:"
        }
      ]
    },
    {
      "id": "claim_8b46f8d33de548ada7e9dd8d25afadca",
      "statement": "Sebastian is pinned to a single repository: Git.StartAsync fails when the content root is not the git top level and throws when origin cannot be parsed into RepositoryIdentity, and PrepareWorkspaceAsync rejects an issue whose owner/repository does not match that parsed origin.",
      "evidence": [
        {
          "resource": "repo://src/Agent/ImplementSpec.cs#L68-L76",
          "version": "repo-lines-v1:sha256:712da247a86982f2c86bbdbd1202f86af79b9c18b336672ba4953a640a490545:"
        },
        {
          "resource": "repo://src/Libs/Git.cs#L27-L54",
          "version": "repo-lines-v1:sha256:04743b75adf9aacca2db0a3dab0e92cd4445e827ee28e392050812fdb3b2eaf8:"
        }
      ]
    },
    {
      "id": "claim_0480c8e2c5c14d3cbaad52fe48c5a87f",
      "statement": "Webhook intake is the only entry point for work and forks at the spec gate: it accepts only Opened, Labeled, Edited and Reopened actions on an open issue carrying the case-insensitive `feature` label; empty required sections cause a comment plus a close as not_planned, and otherwise the presence of `ready-for-agent` is what constructs and enqueues an ImplementSpec job.",
      "evidence": [
        {
          "resource": "repo://src/Webhooks/GitHubWebhookProcessor.cs#L32-L105",
          "version": "repo-lines-v1:sha256:3907686fe48b13846e8b4d70cac3c76da4f1786e1c7d533b58f982610a5f6678:"
        }
      ]
    },
    {
      "id": "claim_7593194fd19349ff85b18558525975c2",
      "statement": "Push deliveries bypass the job queue entirely: ProcessPushWebhookAsync logs the delivery and awaits git.SyncMainAsync inline within the webhook request, a deliberate documented shortcut that makes webhook response latency a constraint on intake changes.",
      "evidence": [
        {
          "resource": "repo://src/Webhooks/GitHubWebhookProcessor.cs#L107-L117",
          "version": "repo-lines-v1:sha256:157fae54eb39a767fcaa9562bc592d1cfa5a6be5dadf7c984f9a08e5a9cc7400:"
        }
      ]
    },
    {
      "id": "claim_32258bacb9c04dcea1d714b46640fcc7",
      "statement": "JobQueue is simultaneously the admission API and the background consumer: an unbounded channel, an OrdinalIgnoreCase in-flight key dictionary held from TryAdd until the job's finally block, MaxConcurrentJobs = 10 via Parallel.ForEachAsync, one async DI scope per job, and per-job catch blocks (including the suppressed CA1031) that log failures so one job cannot tear down the queue.",
      "evidence": [
        {
          "resource": "repo://src/Jobs/IJob.cs#L1-L8",
          "version": "repo-lines-v1:sha256:c6efef8d6c488f1c054421e8f6a73fb550698c8ab062c09d4e9ebeab72d00cb3:"
        },
        {
          "resource": "repo://src/Jobs/JobQueue.cs#L14-L79",
