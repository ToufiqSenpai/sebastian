        }
      ]
    },
    {
      "id": "claim_06e8b8a5d8c5425da9a7cf2eb258867c",
      "statement": "Each agent shell command is confined to the issue worktree with a clean environment, a ten-minute timeout, and a deny-list that blocks git push/reset/clean/checkout --, gh, curl/wget/ssh/scp, and destructive filesystem commands.",
