    {
      "id": "claim_8aefd99fd8d94bb9b16fbaa493673f7a",
      "statement": "Three operationally important signals are logged at Debug and are therefore invisible at the default Information level: \"Local main sync cancelled\" (truncated startup sync), \"Implementation already running for {Repository}#{Number}\" (duplicate delivery dropped rather than queued), and \"Issue {Repository}#{Number} closed; missing spec sections: {Sections}\" (invalid spec closed with no Information-level trace).",
      "evidence": [
        {
