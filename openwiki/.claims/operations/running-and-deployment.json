    },
    {
      "id": "claim_969bc90f6d42482a8d6ab9e7fb580907",
      "statement": "Push deliveries run git.SyncMainAsync inline inside the HTTP request (fetch plus possible fast-forward), so mirror synchronization cost is webhook response latency.",
