    {
      "id": "claim_b76001e4515a44bea21b5837203c8885",
      "statement": ".gitignore excludes .env and .env.* but nothing in the project loads an env file — no env-file package is referenced and no loader exists in code — so values written to .env do nothing and must actually be present in the process environment.",
      "evidence": [
        {
          "resource": "repo://.gitignore#L8-L11",
          "version": "repo-lines-v1:sha256:535bcf197084e1816ea748d917ead195c31d46501e4b23e292d2fa39b70bd57d:"
        },
        {
