    {
      "id": "claim_a19b6e7c265047a09361b40d338cdba0",
      "statement": "The single completion record for a run is the Information-level line \"Implementation completed for {Repository}#{IssueNumber} at {Path}. Git status: {Status}. Agent response: {Response}\", which reports the worktree path and its `git status --short` because nothing is committed.",
      "evidence": [
