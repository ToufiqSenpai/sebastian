    {
      "id": "claim_2c1559fd798b41adb3323f4c6e001373",
      "statement": "Every git invocation runs a real `git` binary from the content root with GIT_TERMINAL_PROMPT=0 and captured output, so an operator must have git on PATH and credential prompts fail fast instead of hanging a request.",
