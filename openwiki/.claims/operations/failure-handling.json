  "claims": [
    {
      "id": "claim_68c0f691ec7f47e7ae1e90d95ad905f8",
      "statement": "Sebastian applies three distinct failure policies by layer: host startup failures (repository identity, configuration validation, credential loading, provider resolution) throw and abort the host; the mirror sync path in Git.SyncMainAsync catches and logs without rethrowing; and exceptions inside a job surface as one Error log line from JobQueue while the loop continues. The intake GitHub write path has no catch at all, so its failures escape the webhook request.",
      "evidence": [
        {
          "resource": "repo://src/GitHub/GitHubService.cs#L40-L69",
          "version": "repo-lines-v1:sha256:0d35813228612814134624f4040cb51d61aac022ec123b62b02fe07731be9c3d:"
        },
        {
          "resource": "repo://src/Jobs/JobQueue.cs#L41-L79",
          "version": "repo-lines-v1:sha256:5586c73a9a67e6eac401a825f74689d10d926114316da1f624b2b1be6b9ebfca:"
        },
