    {
      "id": "claim_95eabf886dc04ee0be88421d5107af5d",
      "statement": "Program.cs resolves GitHubService and ProviderResolver eagerly after builder.Build(), so a missing or malformed PEM private key or an invalid provider configuration fails host startup rather than the first job.",
      "evidence": [
        {
          "resource": "repo://Program.cs#L38-L44",
