    {
      "id": "claim_b29eb6e4942347389960af2645c05646",
      "statement": "Restart semantics: the unbounded channel and the OrdinalIgnoreCase in-flight key set are the only memory-resident job state and both are lost on restart, there is no startup reconciliation of ready-for-agent issues, and worktree directories plus their uncommitted agent output survive on disk under .sebastian/workspaces. Because dedupe keys are in-memory only, a re-labeled or re-edited issue is admitted again immediately after a restart.",
      "evidence": [
        {
          "resource": "repo://Program.cs#L46-L49",
          "version": "repo-lines-v1:sha256:dbeb9fc3a90a3aa99843b7cbed5dd9b741954242b07111c34e19159e53353d1b:"
