    {
      "id": "claim_1274295643294273924cc19508c86d6d",
      "statement": "Worktree reuse makes a retry start from a stale base: PrepareWorkspaceAsync returns an existing .sebastian/workspaces/<issue> directory untouched, so the branch sebastian/issue-<n> is never re-pointed at the refreshed main and files from the previous run are not cleared. Only git worktree add -B (executed when the directory is missing) resets the branch, so removing the directory is the only way to reset a run.",
      "evidence": [
        {
          "resource": "repo://src/Agent/ImplementSpec.cs#L95-L104",
          "version": "repo-lines-v1:sha256:1333daf78242ff1346e331f3cca90b72c1bcd8114847c8035043e18d62eb18cf:"
