    {
      "id": "claim_52fed831e6a84ba5a992c364af0357da",
      "statement": "The PrepareLock semaphore exists because JobQueue executes jobs through Parallel.ForEachAsync with MaxConcurrentJobs = 10, so up to ten ImplementSpec runs would otherwise fetch, fast-forward, and create worktrees concurrently in the single shared clone.",
