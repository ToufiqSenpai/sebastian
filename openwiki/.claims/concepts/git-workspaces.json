    },
    {
      "id": "claim_5f755717129442bdbb061b5a55b9858a",
      "statement": "Because nothing is committed, `.sebastian/workspaces` is the system's only durable artifact store: deleting it destroys all agent output irrecoverably, and a successful run's only record is the source-generated log line that includes the worktree path, `git -C <worktree> status --short`, and the agent response text.",
      "evidence": [
        {
          "resource": "repo://.gitignore#L1-L1",
          "version": "repo-lines-v1:sha256:1d9ee5aecff244280564786633a2e75f354d03c1a9255eaa0b77f76d7dac51ea:"
