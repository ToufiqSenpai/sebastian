        }
      ]
    },
    {
      "id": "claim_8e881432cf714b0095708defc4b77575",
      "statement": "PrepareWorkspaceAsync runs three pre-worktree steps under the static PrepareLock — the null-Repository check, the OrdinalIgnoreCase owner/repository cross-check against origin (message \"Issue repository '<owner>/<repository>' does not match local origin '<local.Owner>/<local.Name>'.\"), and FetchAsync(\"origin\") plus FindMirrorProblemAsync — and throws the mirror problem string as an InvalidOperationException; only after that does it run merge --ff-only origin/main unconditionally.",
      "evidence": [
        {
          "resource": "repo://src/Agent/ImplementSpec.cs#L63-L86",
          "version": "repo-lines-v1:sha256:5b0fac04b714435747b217b6a5347de3ab5cf1a4f542c0d7c1a7eeb48d4dfe54:"
