          "version": "repo-lines-v1:sha256:a136396548d71262973c51ea0754211b88b98d1856284b48a8e494e2b848113e:"
        }
      ]
    },
    {
      "id": "claim_705dab40ce274683ad4b0179acc9bfc2",
      "statement": "The runner spawns `git` via ProcessStartInfo with an argument list and GIT_TERMINAL_PROMPT=0, throws InvalidOperationException carrying stderr on any non-zero exit, and kills the whole process tree on cancellation before rethrowing the OperationCanceledException.",
      "evidence": [
        {
          "resource": "repo://src/Libs/Git.cs#L180-L245",
          "version": "repo-lines-v1:sha256:3f031810ddeef74e6ad8eae523cecdc051aadfe75e8b2895cb57e077cbe25fda:"
        }
