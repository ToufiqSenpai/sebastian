        }
      ]
    },
    {
      "id": "claim_847993594c854d7ca9047a100c9c49db",
      "statement": "Git exposes no commit, push, pull request, or conflict-resolution primitive — its verbs are limited to fetch, merge --ff-only, worktree add/prune, status, rev-parse, rev-list, remote get-url, and branch --show-current — so the absence of a publishing path is an architectural guarantee enforced by the API surface rather than a configuration switch.",
      "evidence": [
        {
          "resource": "repo://src/Libs/Git.cs#L56-L105",
          "version": "repo-lines-v1:sha256:0bd986479d37d7cb4753d1837d886ad64bad2e811997037a15f38df56142f25c:"
