    {
      "id": "claim_acd3c6417b33445d8815e4fbf15525ba",
      "statement": "Each job runs inside an AsyncServiceScope created inside the handler (after dequeue and after a concurrency slot exists) and disposed with await using before the finally releases the key; because every meaningful collaborator (Git, GitHubService, ProviderResolver, JobQueue) is a root singleton, the scope does not produce per-job copies of them and its real contribution is scoped-lifetime services and deterministic disposal.",
      "evidence": [
        {
          "resource": "repo://Program.cs#L19-L28",
          "version": "repo-lines-v1:sha256:18f8a3f5f75a746282936aa86706d377e9e6f5ecbc9ec222267e48f4ea9be623:"
