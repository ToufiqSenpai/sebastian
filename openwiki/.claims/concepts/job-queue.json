    {
      "id": "claim_c6ede3d6bc4a43639adcb79ede77f070",
      "statement": "JobQueue is a single singleton that is simultaneously the admission API called by the webhook path and the BackgroundService the host starts, so TryAdd writes into the same Channel that ExecuteAsync drains; Program.cs registers it with AddSingleton<JobQueue>() plus AddHostedService(sp => sp.GetRequiredService<JobQueue>()) to guarantee that identity.",
      "evidence": [
        {
          "resource": "repo://Program.cs#L27-L28",
