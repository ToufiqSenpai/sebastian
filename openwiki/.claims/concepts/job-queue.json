          "version": "repo-lines-v1:sha256:01d5068155573d3e33dbff02bc7a66ab89962b124067e7b383b060f2fce440e5:"
        }
      ]
    },
    {
      "id": "claim_6baaa898ee3a4ec3b75bb269d79dc2f8",
      "statement": "The in-flight key is removed only in the per-job handler's finally block, so it is held for the entire run including failure; the cancel path releases it too, but no retry is registered anywhere, so a failed job requires another qualifying GitHub event to run again.",
      "evidence": [
