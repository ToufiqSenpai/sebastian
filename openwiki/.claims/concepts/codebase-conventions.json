  "claims": [
    {
      "id": "claim_bc7e65d2b45644cba5cb6da09d0ff7e6",
      "statement": "Sebastian builds with TreatWarningsAsErrors, EnforceCodeStyleInBuild, and AnalysisLevel latest-all, so any new compiler, analyzer, or code-style diagnostic fails the build rather than being ignored.",
      "evidence": [
        {
          "resource": "repo://Sebastian.csproj#L6-L9",
          "version": "repo-lines-v1:sha256:a5412f7c00fa141c66ffc8c78f249b3ce0b3f032b33eb8cfa500ed6332209064:"
        }
      ]
    },
    {
      "id": "claim_9fbcc1d24ed74c8199c211d6a18cfef5",
      "statement": "The project-file comment states the policy for newer analyzer diagnostics exposed by `latest-all`: fix them, or add a justified NoWarn per rule; it also records that an SDK upgrade can surface new analyzer errors.",
      "evidence": [
        {
          "resource": "repo://Sebastian.csproj#L7-L8",
