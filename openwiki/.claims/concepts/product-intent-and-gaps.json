    {
      "id": "claim_0a4d6a9c057644bb95be5ca23bf7505f",
      "statement": "Spec validation runs before the `ready-for-agent` approval check and returns on failure, so a maintainer-approved issue with an empty required section is still closed as `not_planned`; the `ready-for-agent` label is only read from the event payload and never verifies which actor applied it or that the bot wrote it.",
      "evidence": [
        {
