    },
    {
      "id": "claim_ee4c7d4973204efabef4d01ab4c175c3",
      "statement": "The implementation prompt tells the agent to treat the issue body as requirements, not add dependencies, not touch files outside the workspace, not run git/commit/push/create PRs, and to stop if the spec is ambiguous; the host verifies none of this afterwards and a successful run ends at a completion log containing the worktree path, short git status, and agent response text.",
      "evidence": [
        {
          "resource": "repo://src/Agent/ImplementSpec.cs#L112-L135",
          "version": "repo-lines-v1:sha256:c85571a8ba32b1f7e032fbdd337cfc9bda85aba0246845878060389e5ecbd15b:"
