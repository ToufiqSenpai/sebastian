    {
      "id": "claim_c8e6f02c7ee74885a760d4f6329f7fdd",
      "statement": "Intake implements one gate: an open issue labeled `feature` on an opened/labeled/edited/reopened action is the only input; a missing required section causes a comment plus close, and only an issue that also carries `ready-for-agent` is enqueued as an `ImplementSpec` job.",
      "evidence": [
        {
          "resource": "repo://src/Webhooks/GitHubWebhookProcessor.cs#L32-L102",
          "version": "repo-lines-v1:sha256:0960ba62d40379940aa380a36542389dd6610658c2f1b38d5e95109ede33cfb1:"
