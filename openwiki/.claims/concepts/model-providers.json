    {
      "id": "claim_8dc67a31648d486ca7017abb4a50de27",
      "statement": "The shipped appsettings.json configures exactly one provider named 'deepseek' with endpoint https://api.deepseek.com/v1, an API key bound from the {env:DEEPSEEK_API_KEY} placeholder expanded at startup, and Agent:General:Provider/Model set to deepseek and deepseek-v4.1-flash — the same spelling as the entry, so the defaults never exercise case-insensitive selection.",
