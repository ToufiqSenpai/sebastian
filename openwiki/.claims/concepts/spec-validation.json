  "claims": [
    {
      "id": "claim_b1071aaa4f6e45db92b21a886af00487",
      "statement": "The spec validation gate runs only for issues that are open and carry the `feature` label, and only for the `opened`, `labeled`, `edited`, and `reopened` issue actions; every other action, state, or label combination returns silently with no log, comment, or state change — the PRD's per-label bug validation and bug routing have no implementation in code.",
      "evidence": [
        {
          "resource": "repo://docs/PRD.md#L36-L44",
          "version": "repo-lines-v1:sha256:6c1389d501e0eca1005e21498f7e115590d49f4349b6eb9dbfbf0b6b8d33321e:"
        },
