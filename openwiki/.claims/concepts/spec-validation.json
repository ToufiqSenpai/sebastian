          "version": "repo-lines-v1:sha256:a522e16ab9af19bcbb9a97b57ea73b0c743c224180fbb244109aa01955c700cb:"
        }
      ]
    },
    {
      "id": "claim_d13e194f6737497f8d1f92f8c5589fc1",
      "statement": "Because the spec gate records no delivery or comment identifiers, a repeated or redelivered invalid-spec event posts the `Closed: the spec is missing required sections: …` comment again and re-closes an already-closed issue instead of being deduplicated.",
