    },
    {
      "id": "claim_ac9d4f8c6b8241f696d8d4c285f7e43b",
      "statement": "SpecTemplateValidatorTests pins the validator's contract against its own copy of the seven section names — complete spec, absent heading, blank section, `_No response_`, HTML-comment-only section, lowercase headings, CRLF bodies, ignored subheadings and extra sections, optional Further Notes, and null body — but no test exercises GitHubWebhookProcessor, so the guards, ordering, comment text, close reason, and enqueue path rest on review alone.",
      "evidence": [
