    },
    {
      "id": "claim_02a87f1912e74f10b209ef32b21257ff",
      "statement": "The required-section array is a documented duplicate of the `<spec-template>` headings in skills/to-spec/SKILL.md (which also applies the `feature` label when publishing), and nothing tests that coupling — so renaming a heading in either place, adding a required section, or dropping one silently breaks intake or weakens the gate without any build or test failure.",
      "evidence": [
        {
          "resource": "repo://skills/to-spec/SKILL.md#L17-L73",
          "version": "repo-lines-v1:sha256:c17211da139832d9569cc78b6f46674388f34bb9a187ce534cb9e83226c964cb:"
