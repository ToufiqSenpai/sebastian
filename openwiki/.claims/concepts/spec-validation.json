        }
      ]
    },
    {
      "id": "claim_689a0c9e977a4690b2302cc2ee3768c0",
      "statement": "SpecTemplateValidator requires exactly seven markdown sections — Problem Statement, Solution, User Stories, Tech Stack, Implementation Decisions, Testing Decisions, Out of Scope — declared as an ordered static array, so the missing-section list (and therefore the names in the closure comment) follows declaration order rather than document order.",
      "evidence": [
        {
          "resource": "repo://src/GitHub/Issues/SpecTemplateValidator.cs#L6-L15",
          "version": "repo-lines-v1:sha256:f211dda27615f8c1308aa6dd59da8a5ecf356051b77bef200547b0b3cd6f22e6:"
        },
        {
