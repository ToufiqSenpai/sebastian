  "claims": [
    {
      "id": "claim_ff0c0f9bef144353a5e09fe4114b59bc",
      "statement": "The agent layer separates capability configuration from task instruction: AgentRole/ImplementationAgent fix what tools and permissions exist and are identical for every run, while ImplementSpec.BuildPrompt produces the per-issue text describing what this run must do, so a behavior change must be routed to the role (capability) or the prompt (instruction) accordingly.",
      "evidence": [
        {
          "resource": "repo://src/Agent/ImplementSpec.cs#L112-L132",
          "version": "repo-lines-v1:sha256:9b6800bf753ee018f2eebd3dcee9ccd4efcf2bf77182bbcb3f22dc77baa8ffb9:"
        },
        {
