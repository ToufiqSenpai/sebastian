          "version": "repo-lines-v1:sha256:a17de34d51c5d01b8120048c640dfbc49059d0660d390d17ec609c9717ec7b12:"
        }
      ]
    },
    {
      "id": "claim_a58d727bd12241489f747f4355bb9e29",
      "statement": "AgentRole is an abstract class owning no resources: CreateAgent is exactly chatClient.AsHarnessAgent(CreateOptions()), CreateOptions builds a HarnessAgentOptions and delegates to the abstract Configure, and the internal CreateOptions overload exists as a test seam reachable through InternalsVisibleTo so a role's option graph can be asserted without a provider or session.",
      "evidence": [
        {
          "resource": "repo://Sebastian.csproj#L25-L27",
          "version": "repo-lines-v1:sha256:3159a2bd30178eac04b8fdc6a1064ad5ec21ce71fe5870c124ee79dcecf8af82:"
        },
        {
