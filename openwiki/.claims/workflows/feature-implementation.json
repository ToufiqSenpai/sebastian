  "claims": [
    {
      "id": "claim_fac6312db7714ffa95066b47502cb645",
      "statement": "The issues workflow is entered only by IssuesEvent deliveries whose action is Opened, Labeled, Edited, or Reopened and whose payload issue is open and carries a label named `feature` (OrdinalIgnoreCase); all other deliveries return with no side effect, so a closed issue can never be re-validated and only a reopened or re-labeled delivery brings it back into the flow.",
      "evidence": [
        {
          "resource": "repo://src/Webhooks/GitHubWebhookProcessor.cs#L104-L105",
          "version": "repo-lines-v1:sha256:a738bcc56ff2a6df6e42876fc9a2505ef09b6ec099f134d3c09da19ddd9c20bc:"
        },
        {
          "resource": "repo://src/Webhooks/GitHubWebhookProcessor.cs#L32-L57",
          "version": "repo-lines-v1:sha256:a61c90d72e2dbd2f78198af1af433133f6dacff6b9774303840668af8edad61f:"
        }
      ]
    },
    {
      "id": "claim_35496ec682c84b8a94d60f485a4e9d98",
      "statement": "The spec-completeness gate and its return run before the `ready-for-agent` check in the same handler, so an already-approved issue is still commented and closed as not_planned when a required section is unfilled, and no job is created on that branch.",
      "evidence": [
        {
          "resource": "repo://src/Webhooks/GitHubWebhookProcessor.cs#L61-L92",
          "version": "repo-lines-v1:sha256:aec8a2b4a615d3ddd9617bdaf779c997e7b805c3cd18b917218fb52f4f1852ce:"
        }
      ]
    },
    {
      "id": "claim_97f36cb066544a579f0b747d7b506683",
      "statement": "A complete spec without the `ready-for-agent` label returns with no side effect: the issue stays open and dormant, and the only way work starts is a later qualifying delivery that adds the label and re-runs the whole gate.",
      "evidence": [
        {
          "resource": "repo://src/Webhooks/GitHubWebhookProcessor.cs#L84-L101",
          "version": "repo-lines-v1:sha256:fdd2d4f2a8483fade318c2d81bd6a1e7c75efbaa56a6bd9229386427af16fbde:"
        }
