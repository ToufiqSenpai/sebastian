    {
      "id": "claim_a16ee6d7df0e4236a311afba46b0fd90",
      "statement": "ImplementationAgent binds the capability envelope to the preparation-returned workspace path: one LocalShellExecutor confined to that directory with a scrubbed environment and ten-minute command timeout, file tools rooted at the same path with approvals disabled, and web search and file memory turned off.",
