    {
      "id": "claim_4f492359dee6446c99f6bbe8e41f5172",
      "statement": "A single issues delivery resolves to exactly one of seven dispositions — silently dropped (action filter, closed state, missing `feature` label, or null repository/owner/name), closed as invalid, dormant awaiting `ready-for-agent`, deduped by an in-flight key, queued-then-failed, queued-then-cancelled on shutdown, or run — and only the last produces a workspace; only the invalid-spec branch writes to GitHub, and only the run branch ends in `Implementation completed`.",
      "evidence": [
        {
          "resource": "repo://src/Agent/ImplementSpec.cs#L28-L61",
          "version": "repo-lines-v1:sha256:53f9fb148752070c9dbfbaa10f3d40be30a9d3a8cd1fe886893e5b3efe5a177c:"
