    {
      "id": "claim_b3ef44012cff4b6f840c1b7ca16516ee",
      "statement": "Enqueue constructs ImplementSpec from the webhook payload's owner, repository name, issue number, title, and body (the title/body are never re-fetched) and treats JobQueue.TryAdd's boolean as informational only: Information on admission, one Debug line on rejection, no throw and no comment on the issue.",
      "evidence": [
        {
          "resource": "repo://src/Webhooks/GitHubWebhookProcessor.cs#L86-L101",
          "version": "repo-lines-v1:sha256:f26a8fa43977d804f36e0a293b1a37e5114eecb22d67d1d05f1ec5b154c46fe2:"
        }
      ]
    },
    {
      "id": "claim_cfeff28a772b44d8936e2105c59e3dad",
      "statement": "ImplementSpec's primary-constructor parameters are a payload snapshot and its IJob.Key is `{owner}/{repository}#{issueNumber}`, so admission dedupe scope is per issue and any edit delivered while a run is in flight is discarded rather than applied to the running job.",
      "evidence": [
        {
          "resource": "repo://src/Agent/ImplementSpec.cs#L16-L26",
          "version": "repo-lines-v1:sha256:1a955c1a404b4715afb46ca47f8d16922c87579032e0878eaa869a362c6a56c5:"
