    {
      "id": "claim_4deac5d4f6104d77b8c1d10ccb09865d",
      "statement": "Sebastian is published AOT and enables EnableConfigurationBindingGenerator because reflection binding is not AOT-safe, which forces the config classes to use = null!; initializers on non-required properties (the in-file note cites CS9035); converting them to required properties or relying on reflection-based binding breaks the build.",
      "evidence": [
        {
          "resource": "repo://Sebastian.csproj#L10-L15",
          "version": "repo-lines-v1:sha256:d38ea80df098ce59be80ae2b6f7bbc41d8341e0449e698d3052889e1c00bd566:"
