    {
      "id": "claim_30e4243eb61c4edfbd207900bb621212",
      "statement": "Configuration is a startup-time snapshot: every consumer injects IOptions<SebastianConfig> and reads .Value, nothing in the repository uses IOptionsMonitor or IOptionsSnapshot, and Program.cs reads the value once to pass config.GitHub.WebhookSecret into MapGitHubWebhooks, so changing any setting including the webhook secret requires a process restart.",
      "evidence": [
