        }
      ]
    },
    {
      "id": "claim_c28074b5582e4830a694b2af59014e03",
      "statement": "ValidateSebastianConfig is a source-generated options validator: the empty partial class carries [OptionsValidator], so validation logic is emitted at compile time from the DataAnnotations attributes on the config tree, and nested validation is made explicit with [ValidateObjectMembers] on GitHub/Agent/Agent.General and [ValidateEnumeratedItems] on Agent.Providers.",
      "evidence": [
        {
          "resource": "repo://src/Configuration/SebastianConfig.cs#L9-L70",
          "version": "repo-lines-v1:sha256:b7701b83211fd80acd84c38e668c5fe9c523e31baaa01e0e633a7e9ae7b5f6ab:"
        }
      ]
    },
    {
      "id": "claim_3eb7bdace2ef40929081e61ad76c5491",
      "statement": "The SebastianConfig property names are the configuration key paths: GitHub:WebhookSecret, GitHub:AppId, GitHub:PrivateKeyPath, GitHub:InstallationId, Agent:Name, Agent:General:Provider, Agent:General:Model, and Agent:Providers:<index>:{Name,Endpoint,ApiKey}; PrivateKeyPath is a filesystem path, not inline key material, and Agent:Providers binds as an indexed list.",
      "evidence": [
        {
          "resource": "repo://src/Configuration/SebastianConfig.cs#L20-L67",
          "version": "repo-lines-v1:sha256:ae5941155f66a055c5164ec256e665649c3d53138b226a25b04443e9b6309702:"
