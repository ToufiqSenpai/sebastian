    {
      "id": "claim_e0ee8358e1494af589220e065106756d",
      "statement": "Git.StartAsync enforces the single-repository invariant before anything else: EnsureRepositoryAsync compares the trimmed full path of IHostEnvironment.ContentRootPath against `git rev-parse --show-toplevel` and throws the \"Sebastian must run from the repository root...\" InvalidOperationException on mismatch, then parses the origin remote URL and throws \"Could not parse the origin remote URL.\" when RepositoryIdentity.Parse returns null.",
      "evidence": [
