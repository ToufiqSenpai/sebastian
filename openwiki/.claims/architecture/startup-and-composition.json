        }
      ]
    },
    {
      "id": "claim_0a1e9cd0499b42ac805e41e115c16402",
      "statement": "WebhookEventProcessor is registered with a factory that calls the GitHubWebhookProcessor constructor directly rather than AddSingleton<WebhookEventProcessor, GitHubWebhookProcessor>(), because the internal implementation type would otherwise be passed through DI's reflection-based activation path; the factory also pins the four dependencies (logger, GitHubService, JobQueue, Git) at the registration site.",
