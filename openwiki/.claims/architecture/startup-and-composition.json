    {
      "id": "claim_ad7c631f76324fc097efb27a3c0f9578",
      "statement": "Git and JobQueue are each registered twice by design — as singletons and as hosted services resolved through a factory (AddHostedService(sp => sp.GetRequiredService<T>())) — so the instance the host starts is the same instance injected into the webhook processor; a separate AddHostedService<T>() or second singleton would leave the processor holding an uninitialized copy, surfacing as \"Git repository is not initialized\" or a channel nobody reads.",
      "evidence": [
        {
          "resource": "repo://Program.cs#L25-L31",
          "version": "repo-lines-v1:sha256:fee6b797141bf852590d80f4cd28e8c4a88741a28993832cdc533e698c3f3f89:"
