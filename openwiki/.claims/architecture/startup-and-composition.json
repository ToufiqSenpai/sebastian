  "claims": [
    {
      "id": "claim_6e1c31fe563341868069c19c2c77be22",
      "statement": "Program.cs is the sole composition root: it builds the host, expands {env:NAME} placeholders, binds and validates options, registers the singleton and hosted-service descriptors, eagerly resolves GitHubService and ProviderResolver, and maps both endpoints, with no extension methods, Startup class, or second registration site elsewhere in the repository.",
      "evidence": [
        {
          "resource": "repo://Program.cs#L11-L52",
          "version": "repo-lines-v1:sha256:94cf220a8fd8099f1bdd03c3d8f530f7faaf70776dfcf985b10632936d9fcfea:"
        }
      ]
    },
    {
      "id": "claim_dc42685ff04341c09eb9127a4013b605",
      "statement": "Configuration binding is a three-part declaration: AddOptions<SebastianConfig>().Bind(builder.Configuration).ValidateOnStart(), plus ValidateSebastianConfig registered as a singleton IValidateOptions<SebastianConfig>, so an invalid configuration terminates startup instead of surfacing on the first request.",
      "evidence": [
        {
          "resource": "repo://Program.cs#L16-L20",
          "version": "repo-lines-v1:sha256:9e5f8f1d827151e65b50737011dd7e6d186f09579173640ef6dcd7514eb20030:"
        },
        {
