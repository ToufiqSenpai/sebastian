    {
      "id": "claim_2a4e3b48a7384aa08534e88bac9485d9",
      "statement": "There is no database: durable state is limited to git (the local main mirror and per-issue worktrees), GitHub itself (issue labels, body, comments, closed state), and the gitignored .sebastian/ folder; the JobQueue channel and in-flight key set are in-memory only, so queued jobs are lost on restart and only a new qualifying event can re-enqueue work.",
      "evidence": [
        {
          "resource": "repo://.gitignore#L1-L1",
