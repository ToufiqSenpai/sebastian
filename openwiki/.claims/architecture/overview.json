        }
      ]
    },
    {
      "id": "claim_7439b365aeea454dabd77fb4946df61c",
      "statement": "Workspace preparation is serialized process-wide by a single static semaphore in ImplementSpec, because one clone's index and main ref can only be touched by one fetch, fast-forward, and worktree operation at a time; this is the second of the two serialization layers that make concurrent jobs safe, alongside JobQueue key dedupe.",
      "evidence": [
        {
          "resource": "repo://src/Agent/ImplementSpec.cs#L23-L24",
          "version": "repo-lines-v1:sha256:0576f1b593e9868ab2b453e66c149e20168af01fd386b5f8b9e124a0220ee8c7:"
