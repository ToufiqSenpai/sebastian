    {
      "id": "claim_47d9c0a83d064fd6928f36033a70b171",
      "statement": "GitHubWebhookProcessor owns all intake policy as implemented: it ignores issues actions other than opened/labeled/edited/reopened, requires the issue to be open and labeled feature, closes an issue with an explanatory comment (state reason not_planned) when required spec sections are missing, enqueues ImplementSpec only when the ready-for-agent label is present, and handles push events by syncing local main inline in the request instead of through the queue.",
      "evidence": [
        {
          "resource": "repo://src/GitHub/GitHubService.cs#L54-L69",
          "version": "repo-lines-v1:sha256:aaa1a90091654b124874d660e3879e50f4ceb9302da726deeff522dd808f6ba8:"
