        }
      ]
    },
    {
      "id": "claim_9b860def4296407391fff0d817014975",
      "statement": "Git owns command execution only and encodes policy in two behaviors that differ deliberately: SyncMainAsync ignores errors from fetch/mirror checks/fast-forward with warnings, while ImplementSpec.PrepareWorkspaceAsync throws when the mirror is unacceptable, so a foreground run never starts from a dirty, non-main, or ahead local branch.",
      "evidence": [
        {
          "resource": "repo://src/Agent/ImplementSpec.cs#L63-L110",
          "version": "repo-lines-v1:sha256:d1adcc5d278f63232d4ed568e5782aa0cd3c69d10eee1cd5850c4d89195203fc:"
