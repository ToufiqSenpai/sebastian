    {
      "id": "claim_d870a13595684b13a9d1b15805c9027d",
      "statement": "JobQueue is both the admission API and the execution engine: it rejects a duplicate job key while that key is in flight, runs accepted jobs with MaxConcurrentJobs = 10, gives each job its own async DI scope, logs and swallows per-job exceptions so one failure cannot stop the queue, and removes the key in a finally block so a failed job does not permanently block its issue (and is not retried automatically).",
      "evidence": [
        {
          "resource": "repo://src/Jobs/IJob.cs#L3-L8",
          "version": "repo-lines-v1:sha256:3e0705b11dd2d4b2cd02999a7c8448d5c30042f85f90a3cb74d0ccf759285ec3:"
