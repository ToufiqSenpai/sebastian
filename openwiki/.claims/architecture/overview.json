        }
      ]
    },
    {
      "id": "claim_c3d178ff192644098a5e0c8c043e66dc",
      "statement": "The process is hard-wired to a single repository: Git throws when the content root is not the git top level and parses the origin remote into owner/name, and ImplementSpec later rejects any issue whose owner/repository does not match that parsed identity.",
      "evidence": [
        {
          "resource": "repo://src/Agent/ImplementSpec.cs#L68-L76",
          "version": "repo-lines-v1:sha256:712da247a86982f2c86bbdbd1202f86af79b9c18b336672ba4953a640a490545:"
        },
