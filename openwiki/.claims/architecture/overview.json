  "claims": [
    {
      "id": "claim_2e8dc71dbadf4022b9d06b476ddd55dd",
      "statement": "The host exposes exactly two HTTP endpoints: an unauthenticated /health returning \"ok\", and the GitHub webhook endpoint mapped by MapGitHubWebhooks with the secret taken from configuration; no authentication middleware is registered, so the HMAC webhook secret is the only trust boundary.",
      "evidence": [
        {
          "resource": "repo://Program.cs#L46-L47",
          "version": "repo-lines-v1:sha256:249f502f71258975f361ec1b9f2cf31d4bf21a5457c3cbcc4fab521eafecd282:"
        },
        {
