<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <!-- latest-all: SDK upgrade can surface new analyzer errors; fix or justify a NoWarn per rule. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <!-- Reflection binding is not AOT-safe; generated binder needs non-required properties (CS9035). -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="GitHub.Octokit.SDK" Version="0.0.31" />
    <PackageReference Include="Microsoft.Agents.AI.Harness" Version="1.26.0" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.26.0" />
    <PackageReference Include="Microsoft.Agents.AI.Tools.Shell" Version="1.26.0-preview.261023.1" />
    <PackageReference Include="Microsoft.Kiota.Bundle" Version="1.22.2" />
    <PackageReference Include="Octokit.Webhooks.AspNetCore" Version="4.2.3" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Sebastian.Tests" />
  </ItemGroup>
</Project>
